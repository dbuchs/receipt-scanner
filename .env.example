# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=receipt-scanner
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=change-me-to-a-32-byte-fernet-key-base64url=

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://receipt:receipt@db:5432/receipt_scanner

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO / S3 ─────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=receipts

# ── YNAB OAuth ─────────────────────────────────────────────────────────────────
YNAB_CLIENT_ID=your-ynab-client-id
YNAB_CLIENT_SECRET=your-ynab-client-secret
YNAB_REDIRECT_URI=http://localhost:8000/ynab/callback

# ── Watched Folder ─────────────────────────────────────────────────────────────
WATCHED_FOLDER_PATH=/data/watched
WATCHED_FOLDER_POLL_SECONDS=30
